# Frontend environment variables for IOTA ShimmerEVM integration
# Copy this file to `.env` and fill in values

# Contract address after deployment (from Hardhat output)
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# ShimmerEVM Testnet RPC URL
VITE_NETWORK_RPC=https://api.sc.testnet.shimmer.network/chain/rms1prr4r7az8e46qhagz5atugjm6x0xrg27d84677e3lurg0s6s76jr59dw4ls/evm/jsonrpc

# ShimmerEVM Testnet Chain ID
VITE_CHAIN_ID=1076